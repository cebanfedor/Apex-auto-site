{
  "functions": {
    "api/auctions.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/sync-lots", "schedule": "0 5 * * *" }
  ],
  "rewrites": [
    { "source": "/api/sync-lots", "destination": "/api/auctions?action=synclots" },
    { "source": "/api/calc", "destination": "/api/content?calc=1" },
    { "source": "/api/locations", "destination": "/api/content?calc=1&locations=" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/auctions", "destination": "/auctions.html" },
    { "source": "/auctions/:slug", "destination": "/api/lot-page?slug=:slug" },
    { "source": "/tracking", "destination": "/tracking.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contacts", "destination": "/contacts.html" },
    { "source": "/hot", "destination": "/hot.html" },
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/customs", "destination": "/customs.html" },
    { "source": "/auction-fees", "destination": "/auction-fees.html" },
    { "source": "/vin-check", "destination": "/vin-check.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/cases", "destination": "/cases.html" },
    { "source": "/damages", "destination": "/damages.html" },
    { "source": "/shipping", "destination": "/shipping.html" },
    { "source": "/tesla-model-3", "destination": "/tesla-model-3.html" },
    { "source": "/ro/vamuirea-auto", "destination": "/ro-vamuirea-auto.html" },
    { "source": "/ro/ghid-auto-sua", "destination": "/ro-ghid-auto-sua.html" },
    { "source": "/ro/blog", "destination": "/ro-blog.html" },
    { "source": "/ro/taxele-licitatiilor", "destination": "/ro-taxele-licitatiilor.html" },
    { "source": "/ro/verificare-vin", "destination": "/ro-verificare-vin.html" },
    { "source": "/ro/daune-auto", "destination": "/ro-daune-auto.html" },
    { "source": "/ro/transport-maritim", "destination": "/ro-transport-maritim.html" },
    { "source": "/ro/tesla-model-3", "destination": "/ro-tesla-model-3.html" },
    { "source": "/ship-my-car", "destination": "/ship-my-car.html" },
    { "source": "/ro/transport-masina-personala", "destination": "/ro-transport-masina-personala.html" },
    { "source": "/usa-vs-europe", "destination": "/usa-vs-europe.html" },
    { "source": "/toyota-rav4", "destination": "/toyota-rav4.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com 'sha256-0A6+sn4MjLqzGeFrDFsIALYCVUANU1CQ0PIYLKi8QNY=' 'sha256-0C1hRIIyPYSeWNZthznZ2wVZe52fjgK8519QSFTw8TE=' 'sha256-0hITu4/p+H49YLPatUK4SZJt/8S4oD3LPbj4Xt7u9Kk=' 'sha256-7ym5S+fGaQgCdw7lDL2EluSsLUJ34fJ9HZkdoRIqr0A=' 'sha256-8flXS3r5MavUF6Tf3qguNBtKcvJTAPo/Y/ZeF2yi+To=' 'sha256-FL9FXEBgyauU6ovHyROdsEoCXIJrH09Xefy2T+rYT04=' 'sha256-H7astKkx97JAkz88lxvR2eZoj3FXbLuDr6wDnjiPq14=' 'sha256-Lm0mt7PmqHcOYYvXx2hgsBd8zghtshr6g1oh6muS0WE=' 'sha256-OJx3xh8G1kBuZ6RvwauE+2L5Yvn7E1F8WCfCt2Iffv4=' 'sha256-UKFsUfvo1LgAci0yZeJjB8DSrM3cmVS7Ikb74PcZ/ko=' 'sha256-lggYwhQNUzkpIiHMFEH6BOuPJy75siXLB+aKwI1VDUQ=' 'sha256-qiYnxZ6QUO7jkI3Sf/ealRcjniecJNaf72EOdYisn9M=' 'sha256-tEWTkzZLPfUga4dtpCCGy+GvEoJEc30Kgxb96cFjuvc=' 'sha256-yl+hL7EAAA1ELdijEDo2Xk5/UD3FRLNyWJezMv0JkJY='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; media-src 'self' https: blob:; connect-src 'self' https://api.frankfurter.app https://api.fxratesapi.com https://www.google-analytics.com https://vpic.nhtsa.dot.gov; frame-src https://maps.google.com https://www.google.com https://maps.googleapis.com; object-src 'none'; base-uri 'self';" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/auctions",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=900, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/api/content",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/hot-lots",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ]
}
