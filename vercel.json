{
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/auctions", "destination": "/auctions.html" },
    { "source": "/auctions/:slug", "destination": "/api/lot-page?slug=:slug" },
    { "source": "/tracking", "destination": "/tracking.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contacts", "destination": "/contacts.html" },
    { "source": "/hot", "destination": "/hot.html" },
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/customs", "destination": "/customs.html" },
    { "source": "/auction-fees", "destination": "/auction-fees.html" },
    { "source": "/vin-check", "destination": "/vin-check.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/damages", "destination": "/damages.html" },
    { "source": "/shipping", "destination": "/shipping.html" },
    { "source": "/tesla-model-3", "destination": "/tesla-model-3.html" },
    { "source": "/ro/vamuirea-auto", "destination": "/ro-vamuirea-auto.html" },
    { "source": "/ro/ghid-auto-sua", "destination": "/ro-ghid-auto-sua.html" },
    { "source": "/ro/blog", "destination": "/ro-blog.html" },
    { "source": "/ro/taxele-licitatiilor", "destination": "/ro-taxele-licitatiilor.html" },
    { "source": "/ro/verificare-vin", "destination": "/ro-verificare-vin.html" },
    { "source": "/ro/daune-auto", "destination": "/ro-daune-auto.html" },
    { "source": "/ro/transport-maritim", "destination": "/ro-transport-maritim.html" },
    { "source": "/ro/tesla-model-3", "destination": "/ro-tesla-model-3.html" },
    { "source": "/ship-my-car", "destination": "/ship-my-car.html" },
    { "source": "/ro/transport-masina-personala", "destination": "/ro-transport-masina-personala.html" },
    { "source": "/usa-vs-europe", "destination": "/usa-vs-europe.html" },
    { "source": "/toyota-rav4", "destination": "/toyota-rav4.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; connect-src 'self' https://api.frankfurter.app https://api.fxratesapi.com https://www.google-analytics.com https://vpic.nhtsa.dot.gov; frame-src https://maps.google.com https://www.google.com https://maps.googleapis.com; object-src 'none'; base-uri 'self';" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/auctions",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=300" }
      ]
    }
  ]
}
